SMARTLOGIX_ENV=development
SMARTLOGIX_LOG_LEVEL=INFO

DATA_ROOT=data
RAW_DATA_DIR=data/raw
GENERATED_DATA_DIR=data/generated
PROCESSED_DATA_DIR=data/processed
QUARANTINE_DATA_DIR=data/quarantine

LADE_DATA_DIR=data/raw/lade
WEATHER_DATA_DIR=data/raw/weather
LADE_DATASET_REPOSITORY=Cainiao-AI/LaDe

# PostgreSQL - port hote local
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=smartlogix
POSTGRES_USER=smartlogix
POSTGRES_PASSWORD=change_me

# Metabase metadata database
METABASE_PORT=3000
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change_me_metabase

# Airflow metadata database
AIRFLOW_PORT=8080
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_JWT_SECRET=replace_with_a_long_random_secret

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false

MINIO_RAW_BUCKET=smartlogix-raw
MINIO_BRONZE_BUCKET=smartlogix-bronze
MINIO_SILVER_BUCKET=smartlogix-silver
MINIO_GOLD_BUCKET=smartlogix-gold
MINIO_QUARANTINE_BUCKET=smartlogix-quarantine

# Kafka local / streaming
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_DELIVERY_EVENTS_TOPIC=smartlogix.delivery.events
KAFKA_DELIVERY_ALERTS_TOPIC=smartlogix.delivery.alerts
KAFKA_DEAD_LETTER_TOPIC=smartlogix.delivery.dead-letter
KAFKA_TOPIC_PARTITIONS=3
KAFKA_HEAP_MIN=256M
KAFKA_HEAP_MAX=512M

# Spark local. Ces valeurs peuvent etre augmentees sur une machine plus puissante.
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_UI_PORT=8082
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=1g

DEFAULT_CHUNK_SIZE=100000
DEFAULT_RANDOM_SEED=42
