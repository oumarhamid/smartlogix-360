SMARTLOGIX_ENV=development
SMARTLOGIX_LOG_LEVEL=INFO

DATA_ROOT=data
RAW_DATA_DIR=data/raw
GENERATED_DATA_DIR=data/generated
PROCESSED_DATA_DIR=data/processed
QUARANTINE_DATA_DIR=data/quarantine

LADE_DATA_DIR=data/raw/lade
WEATHER_DATA_DIR=data/raw/weather
LADE_DATASET_REPOSITORY=Cainiao-AI/LaDe

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=smartlogix
POSTGRES_USER=smartlogix
POSTGRES_PASSWORD=change_me

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false

MINIO_RAW_BUCKET=smartlogix-raw
MINIO_BRONZE_BUCKET=smartlogix-bronze
MINIO_SILVER_BUCKET=smartlogix-silver
MINIO_GOLD_BUCKET=smartlogix-gold
MINIO_QUARANTINE_BUCKET=smartlogix-quarantine

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DELIVERY_EVENTS_TOPIC=delivery-events
KAFKA_DELIVERY_ALERTS_TOPIC=delivery-alerts
KAFKA_DEAD_LETTER_TOPIC=delivery-dead-letter

DEFAULT_CHUNK_SIZE=100000
DEFAULT_RANDOM_SEED=42